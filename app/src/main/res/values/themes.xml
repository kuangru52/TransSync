<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TransSync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/bg_toolbar</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/bg_bottom_bar</item>

        <!-- Unify Popup and Menu styles -->
        <item name="colorSurface">@color/bg_item</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.TransSync" parent="Base.Theme.TransSync">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <style name="AppPopupTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/bg_item</item>
        <item name="colorSurface">@color/bg_item</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:itemBackground">@color/bg_item</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="actionOverflowMenuStyle">@style/AppPopupMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:itemBackground">@color/bg_item</item>
        <item name="android:dropDownListViewStyle">@style/AppDropDownListView</item>
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:overlapAnchor">false</item>
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
    </style>

    <style name="AppDropDownListView" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">@color/bg_item</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
    </style>

    <style name="AppPopupOverlay" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="android:colorBackground">@color/bg_item</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="NavTheme" parent="Theme.TransSync">
        <item name="listPreferredItemHeightSmall">36dp</item>
        <item name="android:listPreferredItemHeightSmall">36dp</item>
    </style>

    <style name="NavText">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleFab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedRectangleShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
